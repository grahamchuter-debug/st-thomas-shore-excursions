{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "st-thomas-shore-excursions",
  "main": "worker.js",
  "compatibility_date": "2026-06-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["*.html"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
